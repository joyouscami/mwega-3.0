# Contact form (Web3Forms). Free access key from web3forms.com. Until it is set, the form shows an error instead of sending.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Enquiries go to the email address you registered the key with.

# Optional sender. Must be on a domain you have verified in Resend, for example: Mwega <hello@yourdomain>
CONTACT_FROM_EMAIL=

# Your live address, for example https://www.yourdomain (used for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://mwega.com

# Optional fallback if NEXT_PUBLIC_WEB3FORMS_KEY is not set: the form posts to app/api/contact/route.js, which emails through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
